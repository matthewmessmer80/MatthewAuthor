rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAuthor() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.lower() in [
          'memauthor1980@gmail.com',
          'memauthor1980@gamil.com',
          'mmessmer80@gmail.com'
        ]) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'author', 'ADMIN', 'AUTHOR']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['AUTHOR', 'author', 'ADMIN', 'admin'])
      );
    }

    function isEditor() {
      return isAuthor() || (
        isAuthenticated() && (
          (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'author', 'editor', 'ADMIN', 'AUTHOR', 'EDITOR']) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['AUTHOR', 'EDITOR', 'author', 'editor'])
        )
      );
    }

    // Default deny for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins registry
    match /admins/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isEditor());
      allow write: if isEditor();
    }

    // Users registry (Three-Tier User Profiles)
    // Enforces location & profile privacy: Only designated Author can query/view all users.
    // Readers and Editors can only read and manage their own user record.
    match /users/{userId} {
      allow read: if isAuthor() || (isAuthenticated() && request.auth.uid == userId);
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthor() || (
        isAuthenticated() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])
      );
      allow delete: if isAuthor();
    }

    // Comments collection
    match /comments/{commentId} {
      allow read: if resource == null ||
                     (resource.data.status in ['APPROVED', 'approved'] && resource.data.status != 'REMOVED_PENDING_DELETION') ||
                     isEditor() ||
                     (isAuthenticated() && resource.data.userId == request.auth.uid && resource.data.status != 'REMOVED_PENDING_DELETION');
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isEditor() ||
                       (isAuthenticated() &&
                        resource.data.userId == request.auth.uid &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'reportCount', 'moderatedBy', 'moderatedAt', 'removedAt', 'scheduledDeletionAt', 'removalReason', 'removedBy'])) ||
                       (isAuthenticated() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount', 'status']));
      allow delete: if isEditor() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Discussions collection (Community Discussions Board)
    match /discussions/{discussionId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                       request.resource.data.authorId == request.auth.uid &&
                       request.resource.data.rulesAgreed == true;
      allow update: if isEditor() ||
                       (isAuthenticated() &&
                        resource.data.authorId == request.auth.uid &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pinned', 'locked']));
      allow delete: if isEditor() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    // Comment Reports collection
    match /commentReports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterUserId == request.auth.uid;
      allow read, update, delete: if isEditor();
    }

    // Reader Messages (Correspondence from /contact)
    match /messages/{messageId} {
      allow create: if true; // Public contact form
      allow read, update, delete: if isEditor();
    }

    // Site Content (Managed live content from /admin/site)
    match /siteContent/{contentId} {
      allow read: if true;
      allow write: if isAuthor();
    }

    // Books collection
    match /books/{bookId} {
      allow read: if true;
      allow update: if isEditor();
      allow create, delete: if isAuthor();
    }

    // Series collection
    match /series/{seriesId} {
      allow read: if true;
      allow update: if isEditor();
      allow create, delete: if isAuthor();
    }

    // Stories collection: creation and deletion strictly Author-only; update for editors
    match /stories/{storyId} {
      allow read: if true;
      allow create, delete: if isAuthor();
      allow update: if isEditor();
    }

    // News & Dispatches collection
    match /news/{newsId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAuthor();
    }

    // Gallery collection
    match /gallery/{itemId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAuthor();
    }

    // Characters collection
    match /characters/{characterId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAuthor();
    }

    // Lore & Worldbuilding collection
    match /lore/{loreId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAuthor();
    }

    // Media library collection
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isEditor();
    }

    // Newsletter Subscribers
    match /subscribers/{subscriberId} {
      allow create: if request.resource.data.email is string && 
                       request.resource.data.consentGiven == true;
      allow update: if isAuthor() || 
                       (isAuthenticated() && request.auth.uid == request.resource.data.userId) ||
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'status', 'unsubscribedAt', 'welcomeEmailStatus', 'welcomeEmailSentAt',
                         'welcomeEmailEventId', 'welcomeEmailType', 'welcomeEmailError',
                         'userId', 'username', 'updatedAt'
                       ]));
      allow read, delete: if isAuthor();
    }

    // Email Events Collection (Idempotent Welcome Email Tracking)
    match /emailEvents/{eventId} {
      allow read: if true;
      allow create: if request.resource.data.recipientEmail is string &&
                       request.resource.data.emailType in ['NEWSLETTER_WELCOME', 'ACCOUNT_AND_NEWSLETTER_WELCOME'];
      allow update: if isAuthor() ||
                       (request.resource.data.recipientEmail is string &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'deliveryStatus', 'sentAt', 'providerMessageId', 'serverUpdatedAt', 'error', 'retryCount'
                        ]));
      allow delete: if isAuthor();
    }

    // Author-managed welcome email templates
    match /emailTemplates/{templateId} {
      allow read: if true;
      allow write: if isAuthor();
    }

    // Firebase Trigger Email mail collection
    match /mail/{mailId} {
      allow read: if isEditor();
      allow create: if request.resource.data.to != null &&
                       request.resource.data.message.subject is string;
      allow update, delete: if isAuthor();
    }

    // Newsletters collection: author-only
    match /newsletters/{newsletterId} {
      allow read, write: if isAuthor();
    }

    // Audit logs collection
    match /auditLogs/{logId} {
      allow read, create: if isEditor();
      allow update, delete: if false;
    }

    // Global site settings
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAuthor();
    }

    // Short Videos collection
    match /videos/{videoId} {
      allow read: if resource == null ||
                     resource.data.status in ['published', 'PUBLISHED'] ||
                     isEditor();
      allow create: if isEditor();
      allow update: if isEditor() ||
                       (resource != null &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']));
      allow delete: if isAuthor();
    }

    // Songs & Music Library
    match /songs/{songId} {
      allow read: if true;
      allow create: if isAuthor() || (
        isEditor() &&
        (!('seriesId' in request.resource.data) || request.resource.data.seriesId == '' || request.resource.data.seriesId == null) &&
        (!('bookId' in request.resource.data) || request.resource.data.bookId == '' || request.resource.data.bookId == null)
      );
      allow update: if isAuthor() || (
        isEditor() &&
        // Editors cannot modify literary series or book relationships
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['seriesId', 'seriesName', 'bookId', 'bookTitle'])
      );
      allow delete: if isAuthor();
    }
  }
}
